#!/usr/bin/env sh
# cb - repo-root shim so `./cb <command>` works right after clone, no install
# (git-bash / macOS / Linux twin of cb.cmd). `setup.sh` additionally
# pip-installs a PATH-wide `cb` (see tools/run-agent/pyproject.toml).
# Python pick: CB_PYLAUNCH if set, else the first working Python 3.11+ of
# py -3.12 -> py -3 -> python3 -> python (same chain as cb.cmd / setup).
DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

_works() {
  # $1 may contain flags ("py -3.12") - intentional word splitting.
  $1 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1
}

PY="${CB_PYLAUNCH:-}"
if [ -n "$PY" ]; then
  if ! _works "$PY"; then
    echo "cb: cannot start Python 3.11+ via CB_PYLAUNCH=\"$PY\"." >&2
    echo "  Unset CB_PYLAUNCH to use the built-in fallback chain, or point it at a Python 3.11+ exe." >&2
    exit 9
  fi
else
  for cand in "py -3.12" "py -3" "python3" "python"; do
    if _works "$cand"; then PY="$cand"; break; fi
  done
  if [ -z "$PY" ]; then
    echo "cb: no working Python 3.11+ found (tried py -3.12, py -3, python3, python)." >&2
    echo "  Fix: install Python 3.11+ (3.12 recommended), or set CB_PYLAUNCH to a Python 3.11+ exe." >&2
    exit 9
  fi
fi
# Clobbers any pre-set PYTHONPATH on purpose: the separator is OS-specific
# (';' for a Windows Python under git-bash) and the shim must stay portable.
PYTHONPATH="$DIR/tools/run-agent" exec $PY -m aura_rig.cb "$@"
