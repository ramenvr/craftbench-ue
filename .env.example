# ============================================================================
# CraftBench-UE — environment configuration  (copy to `.env` at the repo root)
# ============================================================================
#   cp .env.example .env        # POSIX / git-bash
#   copy .env.example .env      # cmd.exe
#
# `.env` is gitignored; this `.env.example` is the ONLY env file committed, and it
# lists every variable an OPERATOR sets. The launchers load `.env` from the repo
# root.
#
# It is deliberately NOT a list of every variable the code reads. Task authoring
# scripts pass their own private variables to the headless editor they launch
# (CRAFTBENCH_WALKER_YIELD_MODE, CB_R24_KEEP, and ~60 more of that kind); those
# are internal plumbing for authoring one task, never something you set to run
# the benchmark, and listing them here would bury the dozen that matter.
#
# WHICH keys you need depends on WHICH part of CraftBench-UE you run:
#
#   • grade-only (deterministic verifier) ............... nothing here is required.
#       Needs UE 5.8 + Python 3.11+ (3.12 recommended; verifier core alone runs on 3.10) + git/tar; no secrets. See docs/WINDOWS.md.
#   • agent arms (claude-p / unreal-mcp / openrouter) ... ANTHROPIC_API_KEY
#       (claude-p and unreal-mcp need the `claude` CLI on PATH; openrouter:<model>
#       needs OPENROUTER_API_KEY). Nothing else — both arms are clone-and-go.
#
# The third measured arm, `aura-mcp`, is DISCLOSED BUT NOT REPRODUCIBLE from this
# repository: it measures a commercial product whose plugin, servers and account
# entitlement are not public, and its login machinery is not published here. It
# has no keys in this file by design — selecting it fails fast with that message.
#
# Almost everything below AUTO-DETECTS. Set only what your machine needs.
# ----------------------------------------------------------------------------


# === SECRETS — required for the tier you run (no safe default) ==============
#
# Every key below is COMMENTED OUT on purpose (2026-07-26). `setup.ps1` /
# `setup.sh` copies this file verbatim to `.env`, and the loader then exports
# whatever it finds — so an UNCOMMENTED placeholder would be exported
# over a real key the operator already has in their environment, producing an
# auth failure whose cause is invisible (the value looks set, and it is: to
# `sk-ant-xxxx`). A fresh `.env` must parse to ZERO active assignments.
# Uncomment a line only when you are putting a REAL value on it.

# Model access. Required for the claude-p and unreal-mcp arms.
#ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter access. Enables the generalist baseline via OpenRouter's
# Anthropic-compatible API: `cb eval --model openrouter:<provider/model>` (e.g.
# openrouter:openai/gpt-5). Reuses the `claude` CLI pointed at OpenRouter. The
# same slugs drive a leaderboard: `cb matrix --model claude-p:sonnet,openrouter:openai/gpt-5 --task <set>`.
# Key is sent as the Bearer token (NOT x-api-key); do NOT wrap it in quotes.
#OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#OPENROUTER_BASE_URL=https://openrouter.ai/api   # default (Anthropic skin, NOT /api/v1); override only if needed


# === UE 5.8 build tuning (optional; defaults are correct for most hosts) =====
# The verifier disables Unreal Build Accelerator by default (UE 5.8's UBA crashes
# the build with an access violation when its shared cross-run cache is left
# dirty by a killed build). Set =1 ONLY to re-enable UBA (e.g. benchmarking).
#CRAFTBENCH_ALLOW_UBA=1
# Cap UBT parallel actions on RAM-constrained hosts. UE 5.8 editor PCH compiles
# are memory-heavy; at full parallelism a ~32 GB box exhausts the commit charge
# and cl.exe fails with C3859 ("paging file too small"). Use 2 on a ~32 GB host
# (4 can still overflow); leave unset (no cap) on big CI boxes.
#CRAFTBENCH_L1_MAX_PARALLEL=2


# === PATHS — auto-detected; uncomment + edit only if non-standard ===========
# CB_CRAFTBENCH  auto = this repo root (derived from the harness file location)
# CB_UE_ROOT     auto = C:\Program Files\Epic Games\UE_5.8 (Win) /
#                       /Users/Shared/Epic Games/UE_5.8 (Mac)
#                       (resolves UE_5.8 first, older installs only if 5.8 is absent)
#                       CB_UE_ROOT ALWAYS wins over a bare UE_ROOT. The web
#                       dashboard still honours UE_ROOT as a fallback so an
#                       existing Unreal setup keeps working, but never above
#                       the variable documented here.
# CB_PY          auto = `py -3.12` -> py -3 -> python -> python3
# CB_UPROJECT    auto = UE-projects/CraftBenchTemplate/CraftBenchTemplate.uproject
#
#CB_CRAFTBENCH=C:\path\to\craftbench
#CB_UE_ROOT=C:\Program Files\Epic Games\UE_5.8
#CB_PY=py -3.12
#CB_UPROJECT=C:\path\to\craftbench\UE-projects\CraftBenchTemplate\CraftBenchTemplate.uproject
# The ONE machine root every workdir/scratch hangs off (default C:\cb on
# Windows, ~/cb elsewhere). MUST stay SHORT on Windows: verifier workdirs live
# at <CB_ROOT>\wd and a long root hits the 260-char MAX_PATH mid-build — the
# preflight gate blocks roots >60 chars before any build starts.
#CB_ROOT=C:\cb


# === WORKDIR RETENTION — what survives a graded run =========================
# Every graded run leaves its built verifier workdir under <CB_ROOT>\wd — ~5.9 GB
# raw. The default `slim` drops the object tree and debug binaries, leaving a
# ~42 MB workdir that is still a launchable project. Set `full` (or pass
# --keep-workdir) to keep the whole build tree for a run you intend to reopen or
# rebuild; `none` deletes it outright. A run whose L1 FAILED is never slimmed.
# `cb clean --workdirs --slim` reclaims older workdirs in place.
#CB_WORKDIR_RETENTION=slim


# === UNREAL-MCP ARM — Epic's in-editor MCP server ===========================
# The `unreal-mcp` arm talks to Epic's first-party ModelContextProtocol server,
# which the editor serves over HTTP on :8000 by default. Override only if that
# port is taken or the server is bound elsewhere.
#CB_UNREAL_MCP_URL=http://127.0.0.1:8000/mcp


# === OPERATIONAL KNOBS — env-only; none of these are needed for a normal run ==
# Verifier
#CRAFTBENCH_WD_ROOT=                    # verifier workdir root (default <CB_ROOT>\wd)
#CRAFTBENCH_L1_TIMEOUT=                 # seconds for the L1 UBT build (default 1800)
#CRAFTBENCH_GOVERN_RESOURCES=           # 1/0 forces the resource governor on/off
#CRAFTBENCH_DISABLE_ADAPTIVE_UNITY=     # 1 disables UBT adaptive unity builds
#
# Editor / stack
#CB_EDITOR_BOOT_TIMEOUT=                # seconds to wait for the headless editor
#CB_ALLOW_FOREIGN_EDITOR=               # 1 lets teardown kill editors it did not start
#CB_NO_PREFLIGHT=                       # 1 skips the envgate preflight (the --no-preflight twin)
#CB_DRIVE_PROJECT=                      # scratch project for `cb drive`, used as-is, never reset
#CB_GRADED_PROJECT=                     # override the project a graded run materializes
#
# Speed / output
#CB_WARM_CACHE=                         # 1 reuses the L1 warm build pool (a miss falls back to cold)
#CB_WARM_CACHE_DIR=                     # where that pool lives
#CB_FAIRNESS_PARK=                      # where the answer key is parked during the agent phase
#
# Model routing (only if you are not using OpenRouter directly)
#CB_GATEWAY=                            # gateway base URL (default http://127.0.0.1:41200)
#CB_BARE_BASE_URL=                      # OpenAI-compatible endpoint for the `bare` arm
#
# NOTE: `CB_PYLAUNCH` (the interpreter the ./cb and cb.cmd shims boot Python with)
# CANNOT be set here. The shim reads it before any Python starts, which is before
# anything has loaded `.env`. Export it in your shell instead.

# === ADVANCED / TUNING — leave unset unless you know you need it ============
#CB_TMP=                                # scratch + log dir (default: OS temp)
#CB_OPENROUTER_PROVIDER=                # JSON provider block pinned on OpenRouter requests (reproducibility)
#CB_PROXY_INJECT_CACHE=                 # prompt-cache injection on the OpenRouter proxy path
